# 복사해서 .env 로 만들고 값을 채우세요:  cp .env.example .env && chmod 600 .env
# .env 는 절대 Git 에 올리지 마세요.

# 공공데이터포털 개인 API 인증키 (Decoding 키, 88자)
GBIS_KEY=

# PostgreSQL
POSTGRES_DB=bus
POSTGRES_USER=bus
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# 위치정보 하루 호출 상한 (포털 한도 1,000회)
DAILY_LIMIT=990

# 이 날짜까지 응답 원문도 저장 (초기 2주 권장). 비우면 저장 안 함
STORE_RAW_UNTIL=2026-11-19

# 디스코드 웹훅 URL (선택). 비우면 알림 없이 로그와 DB에만 기록
DISCORD_WEBHOOK=

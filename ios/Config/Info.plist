<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 개발 중에는 맥에서 띄운 추론 서버(http://localhost:8000)를 부른다. 배포 서버는 HTTPS로 연다. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 빌드할 때 Config/Secrets.xcconfig 의 HOPORNOT_API_KEY 가 들어간다 (없으면 빈 값) -->
	<key>HopOrNotAPIKey</key>
	<string>$(HOPORNOT_API_KEY)</string>
</dict>
</plist>
